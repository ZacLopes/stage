# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# PostHog (project API key — public, ok no client)
POSTHOG_API_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://us.i.posthog.com

# Note: OPENAI_API_KEY is no longer needed in the client app.
# It's now securely managed in Supabase Edge Functions.
# Set it using: supabase secrets set OPENAI_API_KEY=your_key
